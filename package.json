    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "^13.1.5",
    "@grafana/i18n": "^13.1.5",
    "@grafana/runtime": "^13.1.5",
    "@grafana/schema": "^13.1.5",
